# Secrets for the edge functions. Production: `supabase secrets set --env-file supabase/functions/.env`
# SUPABASE_URL and the Supabase keys are provided automatically; do not add them.

# Paystack → Settings → API Keys & Webhooks. Use the TEST secret key (sk_test_…) until you are ready to go live.
PAYSTACK_SECRET_KEY=

# The public address of the website (no trailing slash). Used for the Paystack return URL and for CORS.
SITE_URL=https://sellsharp.ng

# Optional: extra origins allowed to call the functions (comma separated), e.g. a preview deployment.
# ALLOWED_ORIGINS=https://preview.sellsharp.ng

# Optional: a Paystack plan code (PLN_…) to charge automatically every month. Leave empty for pay-each-month.
# PAYSTACK_PLAN_CODE=
